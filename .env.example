# Safe to expose to the browser. Use the existing Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Safe to expose to the browser. Use the project's publishable/anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required only if the protected demo-reset endpoint is enabled.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Set a long random value when enabling demo reset.
DEMO_RESET_TOKEN=
# Keep false in production unless a controlled demo reset is explicitly needed.
ENABLE_DEMO_RESET=false
